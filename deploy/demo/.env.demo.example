# Voxint demo instance — environment template.
# Copy to .env.demo and fill in the generated values.

# --- Postgres (isolated from the host's existing postgres) ---
POSTGRES_USER=voxint_demo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=voxint_demo

# --- Ports (avoid clashes with existing VPS services) ---
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8180

# --- App config ---
VOXINT_USER=admin
VOXINT_PASSWORD=CHANGE_ME
VOXINT_MULTI_USER=true
CSRF_SECRET=CHANGE_ME
VOXINT_SESSION_TTL_SECONDS=86400
MEDIA_ROOT=./demo-media

# --- Image tag (pin to a release) ---
VOXINT_IMAGE_TAG=0.43.0

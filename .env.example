# Voxint configuration — copy to .env and edit. All values here are safe defaults/examples.

# --- Core services ---
DATABASE_URL=postgresql+psycopg://voxint:voxint@localhost:5432/voxint
REDIS_URL=redis://localhost:6379/0
# Host ports the compose stack publishes on 127.0.0.1 (change if something
# already listens there; container-internal ports are fixed).
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# Release image tag the compose stack runs (see compose.yaml; the default is
# pinned to the release this checkout documents). Build-from-source instead:
# layer compose.build.yaml / compose.gpu.build.yaml (docs/operations.md).
# VOXINT_IMAGE_TAG=0.21.0

# --- Media ---
# Root directory that ingested media lives under.
# Compose: the HOST directory mounted into every container at /data/media
# (the in-container path is pinned; leave this relative or absolute as you
# like). Bare-host: the path the pipeline reads directly (relative paths
# resolve against the working directory).
MEDIA_ROOT=./media

# --- Media retention / garbage collection (issue #15) ---
# OFF by default: nothing is ever reclaimed until you opt in here. When enabled,
# a scheduled sweep unlinks the large normalized-audio intermediate for OLD
# TERMINAL (completed/cancelled) runs and records it on the artifact row. The
# source media, transcript, diarization, and adjudication decisions are ALWAYS
# kept — a reclaimed run stays re-processable from its source.
# MEDIA_RETENTION_ENABLED=false
# Age (seconds) since a run was last modified before its intermediate is
# eligible. Floor 3600 (1 h); default 2592000 (30 d). Only used when enabled.
# MEDIA_RETENTION_SECONDS=2592000
# How often the GC sweep runs (seconds).
# GC_SWEEP_SECONDS=3600
# Max rows reclaimed per sweep, oldest-first (a backlog drains at this rate per
# GC_SWEEP_SECONDS).
# GC_BATCH_LIMIT=500

# --- Watch-folder ingest (issue #60) ---
# Auto-submit new media dropped into your registered folders (Settings → Media
# folders), skipping files already known. OFF by default. This is the INSTALLATION
# default; you can also turn watching on/off at runtime from the Settings page with
# no restart (that override wins over this value).
# WATCH_FOLDER_ENABLED=false
# How often the watch sweep re-checks the registered folders (seconds). This is the
# pickup latency for a dropped file. Floor 30; default 300 (5 min).
# WATCH_FOLDER_SWEEP_SECONDS=300
# How long a file must sit unchanged before it is ingested, so a file still being
# copied in is not picked up mid-write (uses the file's newest mtime/ctime). The
# reliable way to add files is an atomic move/rename into the folder. 0 accepts
# immediately. Default 60.
# WATCH_FOLDER_SETTLE_SECONDS=60

# --- API / review UI ---
API_HOST=127.0.0.1
# Bare-host: the port the API binds. Compose: the HOST port the stack
# publishes (the container bind stays 8080 internally).
API_PORT=8080
# Single-user credential for the API + review UI (basic auth). Startup REFUSES
# a default/empty password whenever API_HOST is not loopback — which includes
# every container run (the image binds 0.0.0.0), so pick a real one.
VOXINT_USER=admin
VOXINT_PASSWORD=
# Secret keying the CSRF token on the mutation forms (POST /submit, /fetch,
# /runs/{id}/requeue). Independent of VOXINT_PASSWORD on purpose. Leave empty for
# a random per-process secret (fine for single-operator localhost, but open forms
# break on restart / across workers); set a persistent random value
# (python -c "import secrets; print(secrets.token_urlsafe(32))") to avoid that.
# CSRF_SECRET=
# Bounded page size for the /runs execution-history browser (keyset paged).
# RUNS_PAGE_SIZE=50
# Triage threshold for the transcript's low-confidence highlight (issue #53): a
# segment whose ASR confidence (a transformed likelihood in [0,1], NOT a
# probability of error) is BELOW this is flagged "uncertain". 0.6 is a
# conservative default; segments with no reported confidence are never flagged.
# REVIEW_LOW_CONFIDENCE_THRESHOLD=0.6
# Hard ceiling on a browser upload (POST /submit), bytes; enforced while
# streaming. Default 5 GiB.
# UPLOAD_MAX_BYTES=5368709120

# --- yt-dlp URL acquisition (ACQUIRE stage; only the worker downloads) ---
# Master switch for URL ingestion (authenticated admin egress). Enforced at the
# submission surface, not the worker. Default true.
# YTDLP_ENABLED=true
# Authoritative ceiling on a downloaded media file, bytes: an early yt-dlp
# --max-filesize hint AND a post-download re-check. Default 5 GiB.
# YTDLP_MAX_BYTES=5368709120
# Hard wall-clock timeout for the whole yt-dlp download, seconds; the process
# group is killed on expiry. Must sit below ACQUIRE_LEASE_SECONDS by a cleanup
# margin (validated at startup). Default 7200 (2 h).
# ACQUIRE_TIMEOUT_SECONDS=7200
# How long a worker may hold the ACQUIRE stage before recovery reclaims it,
# seconds. Must exceed ACQUIRE_TIMEOUT_SECONDS plus the kill/hash/publish tail.
# Default 10800 (3 h).
# ACQUIRE_LEASE_SECONDS=10800
# Per-socket connect/read timeout handed to yt-dlp (--socket-timeout), seconds.
# Default 30.
# YTDLP_SOCKET_TIMEOUT_SECONDS=30
# Optional outbound proxy for yt-dlp (e.g. http://proxy.example:8080 or a
# socks5://host:port). Passed to --proxy; treated as a credential (scrubbed from
# errors). Empty = explicit direct connection: an ambient HTTP(S)_PROXY in the
# worker env is IGNORED, so set this to use a proxy on purpose. Default empty.
# To harden untrusted-URL ingestion WITHOUT setting this by hand, use the opt-in
# `compose.ytdlp-egress.yaml` overlay, which runs a filtering proxy that pins
# yt-dlp to vetted public addresses (see docs/operations.md).
# YTDLP_PROXY=
# Optional cookies file (Netscape format). Must be a readable regular file if set;
# wired to --cookies. Treated as a credential — its path is scrubbed from errors.
# Default unset.
# YTDLP_COOKIES_FILE=

# --- GPU model services (see compose.gpu.yaml) ---
ASR_URL=http://localhost:8022
DIARIZER_URL=http://localhost:8024
EMBEDDER_URL=http://localhost:8021

# --- Hugging Face (OPTIONAL — not needed for the default install) ---
# The diarization weights are vendored into the pyannote image; no account or
# token is involved. Only set this if you also set DIARIZER_MODEL_NAME on the
# pyannote service to pull a different (gated) pipeline from Hugging Face.
# HF_TOKEN=

# Compute tier recorded by the guided installer (scripts/install.sh): which
# model-service overlay it starts on (re-)runs. cpu | gpu | rocm | metal |
# none. Informational for manual `docker compose -f ...` workflows -- Compose
# itself ignores it. The metal tier's model services run natively (started by
# scripts/metal/voxint-metal.sh, not Compose).
# VOXINT_COMPOSE_TIER=none

# ROCm tier only: numeric gid owning /dev/kfd and /dev/dri/renderD* (usually
# the host's "render" group; allocated per host, so it cannot be baked into
# the overlay). The installer detects and records it; manual setup:
# VOXINT_RENDER_GID=$(stat -c %g /dev/kfd)
# VOXINT_RENDER_GID=992

# --- LLM transcript enhancement (optional; any OpenAI-compatible endpoint) ---
# Best-effort: failures leave enhanced_text NULL and never fail a run.
# LLM_ENABLED / LLM_BASE_URL / LLM_MODEL / LLM_API_KEY are all also settable from
# the UI (setup wizard + Settings, issue #10): a value saved in the app takes
# precedence, and these env values are the seed/fallback used when the app has no
# override. Changes made in the UI take effect on the next run/enrichment job with
# no worker restart. A UI-saved API key is stored in the database (plaintext at
# rest — acceptable for this single-operator, local-first deployment) and is never
# rendered back, logged, or exported. Set it here if you prefer env-only config.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Per-attempt timeout. The 300 s default is sized for local models (a ~35B
# model needs 180-300 s per entity-mentions call); cloud endpoints answer in
# seconds and never wait it out on a healthy connection. NOTE: a proxy in
# front of your endpoint can impose its OWN shorter ceiling that no client
# setting overrides — e.g. an OpenAI-compatible proxy observed returning
# HTTP 408 at its own 180 s ceiling; raise the proxy's request-timeout
# setting if long local-model calls 408.
# LLM_TIMEOUT_SECONDS=300
# LLM_ATTEMPTS_PER_BATCH=2
# LLM_BATCH_MAX_SEGMENTS=32
# LLM_BATCH_MAX_CHARS=12000
# LLM_RUN_BUDGET_SECONDS=14400
# LLM_CONSECUTIVE_FAILURE_LIMIT=3

# --- Bundled local LLM (optional; no API key; issue #67) ---
# An opt-in alternative to the BYO endpoint above: a vendored Qwen3-4B-Instruct
# model served locally by the compose.llm.yaml overlay, so enrichment works with
# no external key. Bring it up alongside your compute tier:
#   docker compose -f compose.yaml -f compose.cpu.yaml -f compose.llm.yaml up -d
# Scope is deliberate — the bundle powers ONLY transcript enhancement and
# run-asset summaries + entity mentions. Web research, LLM speaker-name
# suggestions, and run-asset topics still use the BYO endpoint above and never
# fall back to the bundle (a small local model is not reliable at those; #66).
# You can run the bundle AND a distinct BYO endpoint at once: with both set,
# run-asset topics generate on the BYO endpoint; with the bundle active and no
# BYO endpoint configured, topics are skipped (#106).
# LLM_ENABLED must still be true (it is the master enhancement gate). The base
# URL + model below are the compose-injected constants the worker reads; you do
# not normally edit them — compose.llm.yaml sets them for you.
# LLM_BUNDLED_ENABLED=false
# LLM_BUNDLED_BASE_URL=http://voxint-llm:8080/v1
# LLM_BUNDLED_MODEL=qwen3-4b-instruct-2507
# Bundled run-asset input is clamped tighter than the BYO default
# (RUN_ASSETS_MAX_INPUT_CHARS=48000 below): a dense 4B model is a slow CPU
# backstop, so large transcripts would blow the per-attempt timeout. A GPU is
# recommended (see compose.llm.yaml's commented GPU block).
# LLM_BUNDLED_RUN_ASSETS_MAX_INPUT_CHARS=16000

# --- Speaker matching gates (docs/quality-gates.md; defaults are conservative) ---
# Stored confidence is (cosine + 1) / 2 — transformed similarity, not probability.
# MATCH_MAX_OVERLAP_RATIO=0.20
# MATCH_TURN_WEIGHT_CAP_SECONDS=10
# MATCH_MIN_TURNS=2
# MATCH_MIN_SECONDS=6
# MATCH_MIN_COSINE=0.60
# MATCH_MIN_MARGIN=0.05
# MATCH_MIN_VOTE_AGREEMENT=0.60
# GROUNDED_MIN_TURNS=3
# GROUNDED_MIN_SECONDS=10
# GROUNDED_MIN_COSINE=0.70
# GROUNDED_MIN_MARGIN=0.08
# GROUNDED_MIN_VOTE_AGREEMENT=0.67

# --- Domain pack (optional; defaults to the bundled generic pack) ---
# DOMAIN_PACK_PATH is the DEFAULT pack: used for a run whose watched folder has
# no per-folder mapping, and for runs created before per-run selection existed.
# DOMAIN_PACK_PATH=/path/to/your/domain-pack
# DOMAIN_PACKS_DIR: a directory whose direct child folders are each a named pack
# (a folder with a manifest.yaml), so a pack can be selected BY NAME per watched
# folder. Per-folder assignment itself is stored in app_settings.folder_domain_packs
# ({folder -> pack_name}), NOT an env var; each run freezes its resolved pack. The
# operator UI to edit that per-folder map ships with the review-console overhaul
# (issue #63); until then DOMAIN_PACK_PATH is the operator-facing default.
# DOMAIN_PACKS_DIR=/path/to/your/domain-packs

# --- Name-candidate enrichment (issue #38; offline suggestions, never auto-assign) ---
# The offline producer (regex over stored metadata + transcript) is on by default.
# ENRICHMENT_NAMES_ENABLED=true
# The optional LLM name pass is strictly additive and requires LLM_ENABLED=true.
# ENRICHMENT_NAMES_LLM_ENABLED=false

# --- Web research retrieval (issue #39; OFF by default — independent of LLM_*) ---
# Controlled outbound retrieval: pluggable web_search + hardened read_url.
# Enabling an LLM does NOT enable this, and enabling this does not need an LLM.
# When off (the default), the research entrypoints refuse without any network I/O.
# VOXINT_WEB_RESEARCH=false
# Search provider ("searxng" is the only built-in; the interface is pluggable).
# WEB_SEARCH_PROVIDER=searxng
# Required when enabled: your SearxNG instance (a LAN/private URL is expected and
# allowed — result URLs are still held to the full public-address egress policy).
# WEB_SEARCH_BASE_URL=
# Credential for future key-bearing providers; unused by searxng. A secret —
# never appears in errors or logs.
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_MAX_RESULTS=8
# WEB_SEARCH_TIMEOUT_SECONDS=20
# read_url caps: response bytes (compressed responses are refused outright, so
# there is no decompression-bomb surface), redirect hops (each hop is
# re-validated against the egress policy and connected via its vetted address),
# per-hop timeout, total wall clock, and extracted-text ceiling.
# WEB_READ_MAX_BYTES=5242880
# WEB_READ_MAX_REDIRECTS=5
# WEB_READ_TIMEOUT_SECONDS=30
# WEB_READ_TOTAL_SECONDS=60
# WEB_READ_MAX_TEXT_CHARS=60000

# --- Web-research speaker enrichment (issue #40; OFF by default) ---
# Operator-initiated research jobs: an LLM tool loop (web_search / read_url /
# roster lookup) that drafts bio/affiliation/link claims for human review.
# Requires BOTH VOXINT_WEB_RESEARCH=true and LLM_ENABLED=true; refused at
# startup otherwise, and re-checked in the worker before any job runs.
# ENRICHMENT_WEB_RESEARCH_ENABLED=false
# Per-job budgets (shown in the console's start preview; not raisable per job):
# search queries, URL reads, tool-loop rounds, actions per round, wall clock.
# RESEARCH_MAX_SEARCHES=3
# RESEARCH_MAX_READS=5
# RESEARCH_MAX_ROUNDS=5
# RESEARCH_MAX_ACTIONS_PER_ROUND=3
# RESEARCH_DEADLINE_SECONDS=300

# --- Draft triage (issue #42) ---
# Registrable domains you count as authoritative sources. They feed the
# `source_authority` component of the review-priority ordering on web-research
# (bio/affiliation/link) drafts: the fraction of a draft's distinct evidence
# domains that appear here. Comma/space-separated bare domains; a subdomain
# matches its registrable domain (news.example.org matches example.org). No
# built-in list — deployments differ on what is authoritative. Empty (default)
# leaves `source_authority` at 0.0 and ordering to the other signals. Edit and
# restart to change it. For an internationalized domain, enter the punycode
# (xn--...) form — fetched-page hostnames arrive already encoded, so the Unicode
# form would be accepted but never match.
# SOURCE_AUTHORITY_DOMAINS=

# --- Run-level enrichment assets (issue #41; OFF by default) ---
# On-demand LLM-generated summary, topics, and entity mentions per run —
# three independently versioned, independently failing assets shown on the
# run detail page and in the JSON export. Requires LLM_ENABLED=true; refused
# at startup otherwise, and re-checked in the worker before any job runs.
# No egress beyond the configured LLM endpoint.
# ENRICHMENT_RUN_ASSETS_ENABLED=false
# Opt-in post-finalize step: enqueue asset generation when a run completes
# (kinds whose current asset already matches the source are skipped).
# Requires ENRICHMENT_RUN_ASSETS_ENABLED=true.
# ENRICHMENT_RUN_ASSETS_AUTOGENERATE=false
# Character bound on the rendered source document handed to the model; longer
# transcripts are head+tail truncated (recorded on the asset).
# RUN_ASSETS_MAX_INPUT_CHARS=48000

# --- Run notifications / webhooks (issue #12; OFF by default) ---
# Emit a signed webhook when a run reaches a notifiable transition (completed /
# failed). A transactional outbox records intent atomically with the run's state
# change; a beat sweep delivers it at-least-once, outside any DB transaction, so
# a slow or down receiver never affects the pipeline. Nothing is emitted or
# delivered until you enable it here — and enabling later never back-fills runs
# that finished while it was off.
# NOTIFY_ENABLED=false
# The outbound endpoint. Validated (only when enabled) as an absolute,
# credential-free, PUBLIC http/https URL — same egress posture as URL ingestion;
# a private/loopback/link-local target is refused. A signed POST is sent here.
# NOTIFY_WEBHOOK_URL=
# Keys the HMAC-SHA256 signature (X-Voxint-Signature: sha256=<hex>); >= 16 chars,
# required when enabled. Treated as a secret: redacted from every error and log.
# NOTIFY_WEBHOOK_SECRET=
# How often the delivery sweep runs (seconds). Floor 5.
# NOTIFY_SWEEP_SECONDS=30
# Rows delivered per sweep, oldest-first (also bounds one purge batch).
# NOTIFY_BATCH_LIMIT=50
# Attempts before a delivery row is marked dead (capped exponential backoff +
# jitter between attempts).
# NOTIFY_MAX_ATTEMPTS=8
# Retry backoff: base * 2^(attempt-1), capped, plus up to 10% jitter (seconds).
# NOTIFY_BACKOFF_BASE_SECONDS=10
# NOTIFY_BACKOFF_MAX_SECONDS=600
# How long a claimed (in_flight) row is leased before another sweep may reclaim
# it — must exceed one POST's worst-case wall-time (the timeout below).
# NOTIFY_LEASE_SECONDS=60
# Per-POST connect+read timeout (seconds). Kept well under the lease.
# NOTIFY_TIMEOUT_SECONDS=10
# Initial hold on a FAILED arrival before its first attempt, so a synchronous
# requeue can settle and the row be suppressed rather than sent as a misleading
# "failed". Applies to FAILED only.
# NOTIFY_FAILED_INITIAL_DELAY_SECONDS=15
# Age (seconds) after which a settled row (delivered/suppressed) is purged by the
# sweep. dead rows are kept until an operator acts. Floor 3600 (1 h); default 7 d.
# NOTIFY_RETENTION_SECONDS=604800

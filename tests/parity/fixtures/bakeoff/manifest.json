      ],
      "text": "The lighthouse keeper recorded the tide at dawn and again at dusk.",
      "transcript_sha256": "53e889e4f603b9d1d16e1126845bec961a83990e71abeb99d065c4b287b2ef55",
      "ts_granularity": "none",
      "upstream_id": "short_clean_00"
    },
    {

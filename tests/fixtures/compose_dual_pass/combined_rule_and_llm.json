{
  "description": "Rule fires on raw AND the LLM enhanced; enforcement re-applies on the LLM output.",
  "rules": [
    {
      "id": "zb",
      "match": "zoom board",
      "replace": "Zoning Board",
      "whole_word": true
    }
  ],
  "raw": "the zoom board met today",
  "enhanced": "The zoom board met today.",
  "expected_final_text": "The Zoning Board met today.",
  "expected_input_base": "llm",
  "expected_trace": [
    {
      "id": "zb",
      "from": "zoom board",
      "to": "Zoning Board",
      "span": [4, 16]
    }
  ],
  "expected_changed": true
}

# Voxint synthdetect EVAL container (issue #144, Milestone 1 Session S2).
#
# NOT a shipped service image. This is the maintainer eval runtime: it runs
# tools/synthdetect_infer.py with the GPU to produce raw-score journals the host
# scorer (tools/synthdetect_eval.py) consumes. The plan fixes PINNED FAIRSEQ as
# the reference and default serving runtime for M1; the default candidate
# w2v2-aasist loads its wav2vec2-XLS-R SSL front-end through fairseq, so this
# runtime IS part of the inference space and a bump is a visible pin change.
#
# CUDA 11.8 / cuDNN8 devel on Ubuntu 22.04, matching the titanet image (a
# known-good base on the maintainer 3060 hardware); fairseq is compiled and needs
# the devel toolchain.
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-dev python3-pip git gcc g++ libsndfile1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r voxint && useradd -r -g voxint -s /bin/bash voxint

RUN pip3 install --no-cache-dir --upgrade "pip==24.0" "setuptools==69.5.1" "wheel==0.43.0"

# Strict order: numpy -> torch cu118 -> fairseq build deps -> fairseq -> the rest.
RUN pip3 install --no-cache-dir "numpy==1.23.5"
RUN pip3 install --no-cache-dir \
    torch==2.1.0+cu118 torchaudio==2.1.0+cu118 \
    --index-url https://download.pytorch.org/whl/cu118
RUN pip3 install --no-cache-dir \
    "omegaconf==2.0.6" "hydra-core==1.0.7" "bitarray==2.9.2" \
    "sacrebleu==2.4.0" "tensorboardX==2.6.2.2" "cython==0.29.36"

# The reference SSL/CM runtime: fairseq installed from a PINNED git commit. The
# PyPI 0.12.2 release does not build against a modern torch/omegaconf; the git
# revision is the reviewable, reproducible pin. FAIRSEQ_COMMIT has NO default:
# it is frozen in S2b (the first GPU build + validation) and recorded in
# provenance.eval.json under runtime.fairseq_commit; a contract test binds the
# two, and the build FAILS here if the ARG is not supplied, so an unpinned
# runtime can never be built by accident.
ARG FAIRSEQ_COMMIT
RUN test -n "${FAIRSEQ_COMMIT}" || (echo "FAIRSEQ_COMMIT build-arg is required (frozen in S2b; see provenance.eval.json)" >&2; exit 1)
RUN pip3 install --no-cache-dir --no-build-isolation \
    "git+https://github.com/facebookresearch/fairseq.git@${FAIRSEQ_COMMIT}#egg=fairseq"

RUN pip3 install --no-cache-dir \
    "soundfile==0.12.1" "soxr==0.3.7" "scipy==1.10.1" "pyyaml==6.0.1"

# The runner reads the repo tools at runtime (mounted), so no app code is baked;
# only the pinned runtime lives in the image. Weights are NOT baked either: they
# are CANDIDATE, license-gated, and mounted read-only at eval time under
# SYNTHDETECT_WEIGHTS_DIR. Baking them would redistribute non-shippable weights
# and freeze a checkpoint the build never verified.
WORKDIR /repo

ENV CUDA_DEVICE_ORDER=PCI_BUS_ID
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
# Required for torch.use_deterministic_algorithms(True) with CUDA >= 10.2: cuBLAS
# needs a fixed workspace or determinism raises. The runner asserts this exact
# value is present before CUDA init and records it in the journal flags.
ENV CUBLAS_WORKSPACE_CONFIG=:4096:8
# Stable Python hashing so any set/dict ordering in the runner is reproducible
# across the cold-process runs the determinism spike compares.
ENV PYTHONHASHSEED=0

# Weights mount point (read-only volume, supplied by the maintainer at run time).
ENV SYNTHDETECT_WEIGHTS_DIR=/weights

USER voxint
ENV HOME=/repo

# No HEALTHCHECK / EXPOSE: this container runs a one-shot CLI, not a server. The
# entrypoint is the inference runner; the maintainer passes its subcommand+args.
ENTRYPOINT ["python3", "tools/synthdetect_infer.py"]
CMD ["--help"]

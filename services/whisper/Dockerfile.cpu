# Voxint whisper service — CPU flavor (multi-arch: amd64 + arm64).
# Same engine as the CUDA image (faster-whisper / CTranslate2 int8, large-v2
# baked at build); only the torch flavor and base image differ. Contract:
# docs/gpu-contracts.md (POST /v1/transcribe, GET /healthz).
#
# Expect CPU-tier speed: long media takes hours, not minutes. Run the stack
# with COMPUTE_TIER=cpu (compose.cpu.yaml) so stage leases / visibility
# timeouts scale accordingly — see docs/timeouts-and-leases.md.

FROM python:3.11-slim AS builder

ENV PYTHONUNBUFFERED=1

WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
# torch first, pinned to the CPU wheel index on BOTH arches: on amd64 the
# PyPI default torch drags the full CUDA runtime into a CPU image, and the
# explicit index keeps the two arches on the same build. requirements.txt's
# torch pin is then already satisfied (2.1.1+cpu / 2.1.1 aarch64 == 2.1.1),
# mirroring how the CUDA Dockerfile layers cu121 wheels under the same file.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir torch==2.1.1 torchaudio==2.1.1 \
        --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

# Bake the model at build time so the image needs no network at runtime.
# large-v2 is a deliberate policy pin — see docs/gpu-contracts.md. The HF
# revision is pinned so the two per-arch native builds (and any rebuild)
# bake byte-identical weights — an unpinned alias could drift between the
# amd64 and arm64 legs of one release.
ARG WHISPER_HF_REVISION=f0fe81560cb8b68660e564f55dd99207059c092e
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('Systran/faster-whisper-large-v2', device='cpu', download_root='/opt/whisper_models', revision='${WHISPER_HF_REVISION}')"

FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/.cache/huggingface
ENV XDG_CACHE_HOME=/app/.cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libsndfile1 ffmpeg curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r voxint && useradd -r -g voxint -s /bin/bash voxint

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/whisper_models /app/.cache/whisper
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
# Pre-create the alternate-model cache mountpoint so a fresh named volume mounted
# there inherits voxint ownership; otherwise Docker creates it root-owned and the
# non-root service cannot write an alternate model's download (WHISPER_DOWNLOAD_ROOT).
RUN mkdir -p /app/.cache/huggingface /app/model-cache/whisper && chown -R voxint:voxint /app
COPY --chown=voxint:voxint app/ /app/app/

USER voxint
ENV HOME=/app

ENV MEDIA_ROOT=/data/media
ENV WHISPER_MODEL=large-v2
ENV WHISPER_DOWNLOAD_ROOT=/app/.cache/whisper
# Weights are baked — the service must never phone home at startup (a hub
# revision check would stall/fail on air-gapped hosts). WHISPER_REVISION pins
# the load to the baked snapshot so offline resolution needs no ref lookup.
ARG WHISPER_HF_REVISION=f0fe81560cb8b68660e564f55dd99207059c092e
ENV WHISPER_REVISION=${WHISPER_HF_REVISION}
# Baked-snapshot reference for the startup resolver: an alternate model whose
# WHISPER_REVISION still equals this baked large-v2 SHA is a forgotten-revision
# mistake and fails closed (app/whisper_startup.py). Never operator-facing.
ENV WHISPER_BAKED_REVISION=${WHISPER_HF_REVISION}
ENV HF_HUB_OFFLINE=1
ENV DEVICE=cpu
ENV COMPUTE_TYPE=int8
# CPU inference cannot sustain GPU-sized batches; CT2 threading defaults to
# the visible cores, which is the right call here — no OMP override.
ENV BATCH_SIZE=4
ENV PORT=8022

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:${PORT}/healthz || exit 1

EXPOSE 8022

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
